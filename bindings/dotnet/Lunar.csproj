<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- module initializers in libraries are the right tool for transparent DLL import setup -->
    <NoWarn>$(NoWarn);CA2255</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- game plugins reference this as a class library and publish it via their own NativeAOT step -->
    <IsAotCompatible>true</IsAotCompatible>
    <OutputType>Library</OutputType>
    <RootNamespace>Lunar</RootNamespace>
  </PropertyGroup>
</Project>
