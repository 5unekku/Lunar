<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- AOT only for Release (xtask dist); debug builds stay a managed .dll.
         set here (not as a global -p: property) so it does NOT propagate to the
         netstandard2.0 source-generator analyzer, which cannot AOT (NETSDK1207). -->
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <OutputType>Library</OutputType>
    <!-- output name must match what the Rust host passes to PluginLoader::load -->
    <AssemblyName>lunar_scripts</AssemblyName>
    <RootNamespace>PlatformDemoCs</RootNamespace>
    <!-- write generated source to disk so it's inspectable and hot-reload works cleanly -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../bindings/dotnet/Lunar.csproj" />
    <ProjectReference Include="../../../bindings/dotnet-gen/Lunar.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
