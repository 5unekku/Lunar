<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <OutputType>Library</OutputType>
    <!-- output name must match what the Rust host passes to PluginLoader::load -->
    <AssemblyName>lunar_scripts</AssemblyName>
    <RootNamespace>PlatformDemoCs</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../bindings/dotnet/Lunar.csproj" />
  </ItemGroup>
</Project>
